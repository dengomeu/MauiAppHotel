<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.Sobre"
             Title="Sobre"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource BackgroundDark}">

    <VerticalStackLayout VerticalOptions="CenterAndExpand" Padding="20" Spacing="20">

        <Frame BackgroundColor="{StaticResource BackgroundLight}" CornerRadius="15" Padding="20" HasShadow="True">
            <VerticalStackLayout Spacing="15">

                <Label Text="Sobre o aplicativo" 
                       FontSize="24" 
                       FontAttributes="Bold" 
                       TextColor="{StaticResource PrimaryDark}" 
                       HorizontalOptions="Center" />

                <BoxView HeightRequest="1" Color="{StaticResource Gray300}" Margin="0,5" />

                <Label Text="Este aplicativo foi desenvolvido para uma atividade do curso técnico em Desenvolvimento de Sistemas, com foco no aprendizado da estrutura multiplataforma Microsoft .NET MAUI." 
                       FontSize="14" 
                       TextColor="{StaticResource Black}" 
                       HorizontalTextAlignment="Center" />

                <VerticalStackLayout Spacing="5" Margin="0,10,0,0">
                    <Label Text="👨‍💻 Desenvolvedor: Denis Gomes" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Primary}" HorizontalOptions="Center" />
                    <Label Text="📅 Ano: 2026" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Primary}" HorizontalOptions="Center" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </Frame>

        <Button Text="Voltar" 
                BackgroundColor="{StaticResource Secondary}" 
                TextColor="{StaticResource White}" 
                FontAttributes="Bold"
                CornerRadius="8"
                HeightRequest="50"
                Clicked="OnVoltarClicked" />
        
    </VerticalStackLayout>
</ContentPage>